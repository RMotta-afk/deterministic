# Runtime only. Copy to .env and supply a model endpoint/key before ingesting Editor.
MIGRATION_BASE_URL=https://api.openai.com/v1
MIGRATION_API_KEY=
MIGRATION_MODEL=
MIGRATION_SUMMARY_MODEL=
MIGRATION_EMBEDDING_MODEL=text-embedding-3-small
MIGRATION_MAX_COMPLETION_TOKENS=6000
MIGRATION_TIMEOUT_SECONDS=120

# Optional provider rates in USD per million tokens. Leave blank for unknown cost.
MIGRATION_INPUT_USD_PER_MILLION=
MIGRATION_OUTPUT_USD_PER_MILLION=
MIGRATION_EMBEDDING_USD_PER_MILLION=
